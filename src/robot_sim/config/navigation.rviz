Panels: # 左侧显示面板。
  - Class: rviz_common/Displays # 提供显示项和话题状态。
Visualization Manager: # 配置导航坐标和可视化订阅。
  Class: '' # RViz 根管理器。
  Global Options: # 全局显示坐标。
    Fixed Frame: map # 与在线 SLAM 地图及点击目标一致。
  Displays: # 通过 TF 自动显示 odom 中的轨迹和模型。
    - Class: rviz_default_plugins/Grid # 显示地面尺度参考。
      Name: Grid # 界面名称。
      Enabled: true # 默认启用。
    - Class: rviz_default_plugins/Map # 显示动态生成的地图。
      Name: SLAM History Map # 累计地图，非实时避障输入。
      Enabled: true # 默认启用。
      Topic: # 地图使用持久化可靠订阅。
        Value: /map # slam_toolbox 输出。
        Durability Policy: Transient Local # 后启动也可收到地图。
        Reliability Policy: Reliable # 与 SLAM 发布者匹配。
    - Class: rviz_default_plugins/PointCloud2
      Name: Live Planning Obstacles
      Enabled: true
      Topic:
        Value: /ego/cloud
        Reliability Policy: Reliable
      Style: Points
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 80; 30
      Decay Time: 0
    - Class: rviz_default_plugins/RobotModel # 显示真实车型描述。
      Name: V550 # 模型显示名称。
      Enabled: true # 默认启用。
      Description Source: Topic # 从状态发布器读取模型。
      Description Topic: # 模型描述订阅设置。
        Value: /robot_description # 仿真使用的同一份 URDF。
        Durability Policy: Transient Local # 允许 RViz 晚启动。
    - Class: rviz_default_plugins/LaserScan # 显示最新实际扫描。
      Name: Scan # 雷达显示名称。
      Enabled: true # 默认启用。
      Topic: # 雷达 QoS 配置。
        Value: /scan # Gazebo 雷达输出。
        Reliability Policy: Best Effort # 兼容传感器发布者。
      Size (m): 0.03 # 扫描点大小。
    - Class: rviz_default_plugins/MarkerArray # 全局、真实局部曲线和信息。
      Name: Trajectories and Parameters # 青色全局、橙色局部、黄色速度箭头。
      Enabled: true # 默认显示。
      Topic: # 汇总全部轨迹细节。
        Value: /ego/visualization # 独立可视化节点输出。
    - Class: rviz_default_plugins/PointCloud2 # 显示 EGO 真正使用的膨胀占据体素。
      Name: Inflated Obstacles (raw cloud) # 原始点云用于调试；默认由 Marker 按真实格宽显示。
      Enabled: false # 默认显示安全包络。
      Topic: # 不是绘制近似圆，而是读取实际膨胀地图。
        Value: /drone_0_grid/grid_map/occupancy_inflate # EGO 地图输出。
        Reliability Policy: Reliable # 与规划器发布者匹配。
      Style: Flat Squares # 俯视更容易观察膨胀范围。
      Size (m): 0.1 # 与当前体素分辨率一致。
      Alpha: 0.25 # 半透明避免遮挡路径。
      Color Transformer: FlatColor # 使用统一紫色表示膨胀区域。
      Color: 180; 80; 255 # 与黑白地图和雷达点分开。
    - Class: rviz_default_plugins/Path # 显示实际车辆走过的路径。
      Name: Executed Path # 蓝色实际轨迹，可与橙色期望轨迹比较。
      Enabled: true # 默认启用。
      Topic: # 来源是里程计反馈。
        Value: /ego/executed_path # 可视化节点限长缓存。
      Color: 60; 120; 255 # 蓝色代表实际运动。
      Line Style: Lines # 连续折线。
      Line Width: 0.03 # 避免盖住规划曲线。
  Tools: # 保留移动视角与点击目标工具。
    - Class: rviz_default_plugins/Interact # 操作可视化界面。
    - Class: rviz_default_plugins/MoveCamera # 移动视角。
    - Class: rviz_default_plugins/SetGoal # 点击拖动生成目标。
      Topic: # 由适配器转换到 odom。
        Value: /goal_pose # RViz2 标准目标输入。
  Views: # 俯视便于二维导航。
    Current: # 默认视角。
      Class: rviz_default_plugins/TopDownOrtho # 二维正交视图。
      Scale: 45 # 调整地图可见范围。
      Target Frame: map # 视图固定在在线地图。
