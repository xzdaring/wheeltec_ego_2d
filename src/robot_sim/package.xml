<?xml version="1.0"?>
<!-- ROS 包清单：colcon 根据包名、构建类型和依赖确定如何构建这个目录。 -->
<package format="3">
  <!-- 启动命令 ros2 launch robot_sim 中使用的就是这个名字。 -->
  <name>robot_sim</name>
  <version>0.0.1</version>
  <description>V550_mec Gazebo 平面全向运动仿真</description>
  <maintainer email="ubuntu@example.com">ubuntu</maintainer>
  <license>Apache-2.0</license>
  <!-- 本包主要安装资源文件，仍通过 ament_cmake 注册为 ROS 包。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Python 启动描述及 ROS 节点启动功能。 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- 通过 ROS 包索引定位资源，避免写死源码路径。 -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- 展开 xacro，得到 Gazebo 和状态发布器共同使用的完整 URDF。 -->
  <exec_depend>xacro</exec_depend>
  <!-- 机器人模型来自独立描述包；声明依赖使构建顺序正确。 -->
  <exec_depend>wheeltec_robot_urdf</exec_depend>
  <!-- 根据 URDF 与关节状态发布机器人内部 TF。 -->
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- 提供 Gazebo 启动入口、生成机器人服务及 /clock 接口。 -->
  <exec_depend>gazebo_ros</exec_depend>
  <!-- 提供平面运动和关节状态两个共享库插件。 -->
  <exec_depend>gazebo_plugins</exec_depend>
  <!-- 在线导航使用 rclpy 提供消息、计算或运行节点。 -->
  <exec_depend>rclpy</exec_depend>
  <!-- 在线导航使用 numpy 提供消息、计算或运行节点。 -->
  <exec_depend>python3-numpy</exec_depend>
  <!-- 在线导航使用 tf2_ros 提供消息、计算或运行节点。 -->
  <exec_depend>tf2_ros</exec_depend>
  <!-- 在线导航使用 sensor_msgs_py 提供消息、计算或运行节点。 -->
  <exec_depend>sensor_msgs_py</exec_depend>
  <!-- 在线导航使用 sensor_msgs 提供消息、计算或运行节点。 -->
  <exec_depend>sensor_msgs</exec_depend>
  <!-- 在线导航使用 geometry_msgs 提供消息、计算或运行节点。 -->
  <exec_depend>geometry_msgs</exec_depend>
  <!-- 在线导航使用 nav_msgs 提供消息、计算或运行节点。 -->
  <exec_depend>nav_msgs</exec_depend>
  <!-- 在线导航使用 quadrotor_msgs 提供消息、计算或运行节点。 -->
  <exec_depend>quadrotor_msgs</exec_depend>
  <!-- 在线导航使用 traj_utils 提供消息、计算或运行节点。 -->
  <exec_depend>traj_utils</exec_depend>
  <!-- 在线导航使用 ego_planner 提供消息、计算或运行节点。 -->
  <exec_depend>ego_planner</exec_depend>
  <!-- 在线导航使用 slam_toolbox 提供消息、计算或运行节点。 -->
  <exec_depend>slam_toolbox</exec_depend>
  <!-- 在线导航使用 rviz2 提供消息、计算或运行节点。 -->
  <exec_depend>rviz2</exec_depend>
  <!-- 轨迹、箭头和参数文字的可视化消息。 -->
  <exec_depend>visualization_msgs</exec_depend>
  <!-- 参数文字通过 ROS 标准服务读取真实运行值。 -->
  <exec_depend>rcl_interfaces</exec_depend>
  <export>
    <!-- 告诉 colcon 使用 ament_cmake 处理本包。 -->
    <build_type>ament_cmake</build_type>
  </export>
</package>
